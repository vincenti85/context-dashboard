# ─ Neon Postgres (via Vercel Marketplace) ─
DATABASE_URL=postgres://user:pass@ep-pooler.region.aws.neon.tech/db?sslmode=require
DIRECT_URL=postgres://user:pass@ep-direct.region.aws.neon.tech/db?sslmode=require

# ─ Auth (personal admin tool) ─
ADMIN_PASSWORD=your-strong-password-here

# ─ Worker/cron endpoints (/api/jobs/run, /api/cron/daily) ─
# Bearer token compared with constant-time equality (see lib/auth.ts).
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-32-byte-hex-secret-here
# Public URL of this deployment, used for self-invoke after enqueue().
APP_URL=https://your-app.vercel.app

# ─ AI (provider chain, built from whichever keys are set) ─
# Google AI Studio: https://aistudio.google.com/apikey (no credit card required)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key-here
# Optional fallback. Groq Console: https://console.groq.com/keys
# Leave unset to run Gemini-only — an absent key simply shortens the chain.
# GROQ_API_KEY=your-groq-key-here

# ─ Email notifications (Resend free tier: 3,000/mo, 100/day) ─
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-key-here
NOTIFY_EMAIL=leed44800@gmail.com

# ─ YouTube Data API / Analytics API ─
# API key (Google Cloud Console -> Credentials) for search.list/videos.list (WP5).
YOUTUBE_API_KEY=your-youtube-data-api-key-here
# OAuth client (WP9: videos.update metadata + Analytics API). Optional until Should-tier work begins.
YOUTUBE_CLIENT_ID=your-oauth-client-id-here
YOUTUBE_CLIENT_SECRET=your-oauth-client-secret-here
YOUTUBE_REFRESH_TOKEN=obtained-via-oauth-flow-see-README
